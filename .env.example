# Copy to .env. docker compose reads JWT_SECRET from it (required);
# the other values are only used for local (non-Docker) development.

DATABASE_URL="postgresql://photoshare:photoshare@localhost:5432/photoshare?schema=public"

S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="photos"

# Used to sign session cookies. Generate: openssl rand -hex 32
JWT_SECRET="change-me-run-openssl-rand-hex-32"

# Set to "true" only when serving over HTTPS.
COOKIE_SECURE="false"

# Public base URL used to build shareable album links. Optional:
# falls back to the request origin when unset.
# NEXT_PUBLIC_APP_URL="http://192.168.0.10:3000"
