# Copy to .env and fill in. docker compose reads everything from here; the
# DATABASE_URL / S3_* lines are only used for local development without Docker.
# Generate each secret with:  openssl rand -hex 32
# (hex only: values go into URLs, so avoid symbols)

# ── Required ────────────────────────────────────────────────────────────────
JWT_SECRET=""
POSTGRES_PASSWORD=""
MINIO_ROOT_USER="photoshare"
MINIO_ROOT_PASSWORD=""

# Public domain (DNS must point to this server). Caddy gets the HTTPS
# certificate for it automatically. "localhost" = local test with a local CA.
DOMAIN="localhost"
# Public base URL used in e-mails and share links. Always set it in
# production — links are never built from the request's Host header then.
APP_URL="https://localhost"

# ── Operator identification (footer, Terms, Privacy Policy) ─────────────────
# Decreto 7.962/2013 and LGPD art. 9/41.
LEGAL_NAME=""
LEGAL_DOCUMENT=""          # CNPJ (or CPF)
LEGAL_ADDRESS=""
LEGAL_CITY=""              # foro, e.g. "São Paulo/SP"
LEGAL_CONTACT_EMAIL=""
LEGAL_PRIVACY_EMAIL=""     # canal do encarregado (LGPD); defaults to contact
LEGAL_ABUSE_EMAIL=""       # denúncias; defaults to contact

# ── Captcha: Cloudflare Turnstile (optional, recommended) ───────────────────
# Create keys at dash.cloudflare.com → Turnstile. Disabled when empty.
# Test keys that always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── E-mail via SMTP (optional, recommended) ──────────────────────────────────
# Enables e-mail confirmation and "forgot password". Without it, the admin
# generates password reset links in the Users page.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""               # e.g. "PhotoShare <nao-responda@seudominio.com.br>"

# ── Limits ───────────────────────────────────────────────────────────────────
DEFAULT_STORAGE_QUOTA_MB="10240"   # quota for new sign-ups; 0 = unlimited
MAX_UPLOAD_MB="200"                # largest single photo
MAX_REQUEST_BODY="210MB"           # proxy limit; keep a bit above MAX_UPLOAD_MB
ACCESS_LOG_RETENTION_DAYS="190"    # Marco Civil art. 15: minimum 6 months

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_HOUR="3"                    # daily, UTC
BACKUP_KEEP_DAYS="14"
# Off-site copy (any S3-compatible: Backblaze B2, Wasabi, AWS S3, R2…).
BACKUP_REMOTE_URL=""               # e.g. https://s3.us-west-004.backblazeb2.com
BACKUP_REMOTE_BUCKET=""
BACKUP_REMOTE_ACCESS_KEY=""
BACKUP_REMOTE_SECRET_KEY=""

# ── Ports (change only if 80/443 are taken) ──────────────────────────────────
# HTTP_PORT="80"
# HTTPS_PORT="443"

# ── Local development without Docker (npm run dev) ───────────────────────────
DATABASE_URL="postgresql://photoshare:CHANGE_ME@localhost:5432/photoshare?schema=public"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="photoshare"
S3_SECRET_KEY="CHANGE_ME"
S3_BUCKET="photos"
COOKIE_SECURE="false"
