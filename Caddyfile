# HTTPS reverse proxy in front of the app. With a real domain in DOMAIN
# (DNS pointing to this server, ports 80/443 open), Caddy gets and renews a
# Let's Encrypt certificate automatically. DOMAIN=localhost uses a local CA.
# Several addresses are allowed: DOMAIN="localhost, 192.168.1.10".

{
	# Certificate used when the client sends no SNI — browsers don't when the
	# site is opened by IP address (e.g. https://192.168.1.10 on a LAN).
	default_sni {$DEFAULT_SNI:localhost}

	servers {
		# Real visitor IP behind the Cloudflare proxy ("orange cloud"). Only
		# connections coming from Cloudflare's edge may set it, through
		# CF-Connecting-IP; anyone else gets their socket address. Harmless
		# when the DNS isn't proxied. Ranges: https://www.cloudflare.com/ips
		# (last updated 2026-10-09 — refresh if Cloudflare adds new ones).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# Largest request accepted; keep a bit above MAX_UPLOAD_MB.
	request_body {
		max_size {$MAX_REQUEST_BODY:210MB}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy app:3000 {
		# The resolved visitor IP (see trusted_proxies above). Overwrites any
		# X-Real-IP the client sent; the app uses it for rate limiting and the
		# Marco Civil access logs.
		header_up X-Real-IP {client_ip}
	}
}
