generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  password        String
  role            Role       @default(USER)
  // Defaults to ACTIVE so accounts that existed before approval was
  // introduced keep working; new sign-ups are created as PENDING.
  status          UserStatus @default(ACTIVE)
  // Storage limit for this user's originals, in MB. null = unlimited.
  storageQuotaMb  Int?
  // Brute-force lock: consecutive wrong passwords; once it hits the limit
  // lockedAt is set and only an admin can unlock the account.
  failedLogins    Int        @default(0)
  lockedAt        DateTime?
  // null = e-mail not confirmed yet (only enforced when SMTP is configured).
  emailVerifiedAt DateTime?
  // Which Terms/Privacy version the user accepted, and when (LGPD proof).
  termsVersion    String?
  termsAcceptedAt DateTime?
  // Embedded in each session JWT; bumping it (on password change) makes
  // every existing session invalid.
  sessionVersion  Int        @default(0)
  createdAt       DateTime   @default(now())
  albums          Album[]
  tokens          Token[]
}

model Album {
  id            String    @id @default(cuid())
  title         String
  description   String?
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shareToken    String?   @unique
  isPublic      Boolean   @default(false)
  allowDownload Boolean   @default(true)
  coverPhotoId  String?
  // Taken down by moderation (e.g. after a report): the public link stops
  // working and the owner can't re-publish until an admin lifts it.
  blockedAt     DateTime?
  blockedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  photos        Photo[]
  reports       Report[]

  @@index([ownerId])
}

model Photo {
  id          String   @id @default(cuid())
  albumId     String
  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  width       Int?
  height      Int?
  storageKey  String
  thumbKey    String
  previewKey  String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([albumId])
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

// Single-use tokens sent by e-mail (or handed out by an admin). Only the
// SHA-256 of the token is stored.
model Token {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Marco Civil da Internet, art. 15: application access records (IP, date
// and time) must be kept for 6 months. Deliberately not tied to User by FK so
// the records survive account deletion for that legal period.
model AccessLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  event     String
  ip        String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Abuse reports from public album viewers (Marco Civil art. 21 takedowns).
model Report {
  id            String       @id @default(cuid())
  albumId       String?
  album         Album?       @relation(fields: [albumId], references: [id], onDelete: SetNull)
  albumTitle    String
  reason        String
  details       String?
  reporterEmail String?
  ip            String
  status        ReportStatus @default(OPEN)
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?

  @@index([status])
}
